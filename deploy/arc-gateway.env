# CPU-ARC configuration — the single source of truth for model names and
# locations, used by the gateway service AND the nightly curator cron.
#
#   Edit this file, then:  systemctl restart arc-gateway
#   (the curator picks changes up on its next run automatically)
#
# Every value here is a *default* for the Python components; explicit CLI
# flags on the command line still win.

# --- where the models are / what they're called ---
ARC_CHAT_URL=http://127.0.0.1:8080/v1
ARC_EMBED_URL=http://127.0.0.1:8081
ARC_MODEL=unsloth/Qwen3.8-27B-GGUF:UD-Q6_K_M
# Model used by the builder/promotion gate. Leave empty to use ARC_MODEL,
# or point builds at a stronger/slower model than the runtime fallback.
ARC_BUILD_MODEL=

# --- gateway service (arc-gateway.service) ---
ARC_PORT=8084
ARC_HOST=0.0.0.0
ARC_CACHE_DIR=/var/lib/arc/cache
ARC_ENTRY_THRESHOLD=0.72
# Per-family thresholds from CALIBRATION.md (never a single global number)
ARC_FAMILY_THRESHOLDS=gcd=0.72,divisors=0.68,lcm=0.78
ARC_MIN_SEPARATION=0.05
ARC_BUILD_QUEUE_DIR=/var/lib/arc/build_queue
ARC_LOG_RETENTION_DAYS=30

# --- nightly curator (cron: arc-curator) ---
# window of the invocation log to mine each night
ARC_CURATOR_SINCE_HOURS=168
# a cluster needs at least N repeats to be auto-promotable
ARC_CURATOR_MIN_REPEATS=3
# embedder for clustering: server (local, ARC_EMBED_URL) with hash fallback
ARC_CURATOR_EMBED=server
# 1 = run gated promotes; 0 = report only (human review)
ARC_CURATOR_AUTO_PROMOTE=1
# cap on gated builds per night (each ~2-3 min of local model time)
ARC_CURATOR_MAX_PROMOTIONS=2
ARC_CURATOR_CASES=10
ARC_CURATOR_TOP=10
ARC_CURATOR_GOLDEN_MAP=/etc/arc/golden-map.json
# new-family signal: flag a semantic region as a family SEED CANDIDATE when
# its out-of-band miss volume over the window reaches this (report only —
# the loop never auto-creates families)
ARC_FAMILY_CANDIDATE_MIN=5
