# CPU-ARC gateway + curator configuration.
# Installed to /etc/arc/gateway.env by deploy/install.sh — edit that file,
# then `systemctl restart arc-gateway`. Values are shell-quoted.

# --- gateway service (arc-gateway.service) ---
PORT=8084
HOST=0.0.0.0
CACHE_DIR=/var/lib/arc/cache
CHAT_URL=http://127.0.0.1:8080/v1
EMBED_URL=http://127.0.0.1:8081
MODEL=unsloth/Qwen3.8-27B-GGUF:UD-Q6_K_M
ENTRY_THRESHOLD=0.72
FAMILY_THRESHOLDS=gcd=0.72,divisors=0.68,lcm=0.78
MIN_SEPARATION=0.05
BUILD_QUEUE_DIR=/var/lib/arc/build_queue
LOG_RETENTION_DAYS=30

# --- nightly curator (cron: deploy/arc-curator.cron -> nightly_curate.sh) ---
# window of the invocation log to mine each night
CURATOR_SINCE_HOURS=168
# a cluster needs at least N repeats to be auto-promotable
CURATOR_MIN_REPEATS=3
# embedder for clustering: server (local :8081) with hash fallback
CURATOR_EMBED=server
# 1 = run gated promotes; 0 = report only (human review)
CURATOR_AUTO_PROMOTE=1
# cap on gated builds per night (each ~2-3 min of local model time)
CURATOR_MAX_PROMOTIONS=2
CURATOR_CASES=10
CURATOR_TOP=10
CURATOR_GOLDEN_MAP=/etc/arc/golden-map.json
