[Unit]
Description=CPU-ARC semantic cache gateway (cache-first LLM sidecar)
Documentation=file:__REPO__/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__REPO__
# All tunables — model names, model URLs, ports, thresholds — live in
# /etc/arc/gateway.env (ARC_* variables). Edit that file, then:
#   systemctl restart arc-gateway
EnvironmentFile=-/etc/arc/gateway.env
Environment=MALLOC_ARENA_MAX=2
Environment=PYTHONUNBUFFERED=1
# CACHE_DIR and BUILD_QUEUE_DIR must live outside the repo (see sandboxing).
ExecStart=__PYTHON__ -m arc.gateway \
    --port ${ARC_PORT} \
    --host ${ARC_HOST} \
    --cache-dir ${ARC_CACHE_DIR} \
    --chat-url ${ARC_CHAT_URL} \
    --embed-url ${ARC_EMBED_URL} \
    --model ${ARC_MODEL} \
    --entry-threshold ${ARC_ENTRY_THRESHOLD} \
    --family-threshold "${ARC_FAMILY_THRESHOLDS}" \
    --min-separation ${ARC_MIN_SEPARATION} \
    --lazy-build \
    --build-queue-dir ${ARC_BUILD_QUEUE_DIR} \
    --log-retention-days ${ARC_LOG_RETENTION_DAYS}
Restart=always
RestartSec=5
TimeoutStopSec=30
# Containment: gateway + its bounded worker pool
MemoryMax=2G
CPUQuota=400%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/arc

[Install]
WantedBy=multi-user.target
