[Unit]
Description=CPU-ARC semantic cache gateway (cache-first LLM sidecar)
Documentation=file:__REPO__/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__REPO__
EnvironmentFile=-/etc/arc/gateway.env
Environment=MALLOC_ARENA_MAX=2
Environment=PYTHONUNBUFFERED=1
# All tunables come from /etc/arc/gateway.env (see deploy/arc-gateway.env).
# CACHE_DIR and BUILD_QUEUE_DIR must live outside __REPO__ for the sandbox
# hardening below to work.
ExecStart=__PYTHON__ -m arc.gateway \
    --port ${PORT} \
    --host ${HOST} \
    --cache-dir ${CACHE_DIR} \
    --chat-url ${CHAT_URL} \
    --embed-url ${EMBED_URL} \
    --model ${MODEL} \
    --entry-threshold ${ENTRY_THRESHOLD} \
    --family-threshold "${FAMILY_THRESHOLDS}" \
    --min-separation ${MIN_SEPARATION} \
    --lazy-build \
    --build-queue-dir ${BUILD_QUEUE_DIR} \
    --log-retention-days ${LOG_RETENTION_DAYS}
Restart=always
RestartSec=5
TimeoutStopSec=30
# Containment: gateway + its bounded worker pool
MemoryMax=2G
CPUQuota=400%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/arc

[Install]
WantedBy=multi-user.target
